# Copy to backend/.env (never commit .env).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# Local MongoDB container (default). For Atlas, paste the Atlas URI here instead,
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=zad
